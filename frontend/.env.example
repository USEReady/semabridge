# API base URL (defaults to /api — change for standalone frontend deployments)
VITE_API_BASE_URL=/api

# Auth base URL (defaults to /auth)
VITE_AUTH_BASE_URL=/auth

# WebSocket alerts URL (auto-derived from VITE_API_BASE_URL if not set)
# VITE_WS_ALERTS_URL=ws://localhost:8000/ws/alerts

# Request timeout configuration (milliseconds)
VITE_API_TIMEOUT_MS=60000
VITE_RUN_TIMEOUT_MS=600000
VITE_HEALTH_TIMEOUT_MS=5000

# Cache configuration
VITE_CACHE_TTL_MS=120000
VITE_CACHE_MAX_ITEMS=200

# WebSocket reconnect/ping configuration
VITE_WS_RECONNECT_DELAYS=5000,10000,30000
VITE_WS_PING_INTERVAL_MS=30000

# Error tracking (Sentry) — leave blank to disable
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
