# Microsoft Fabric Configuration
# tenant_id: use 'organizations' for multi-tenant / device-code flow, or your actual Azure AD tenant GUID
FABRIC_TENANT_ID=organizations
# client_id: well-known Power BI public client (used for device-code / interactive login)
FABRIC_CLIENT_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46
# client_secret is only needed for service-principal (non-interactive) auth — leave blank for device-code flow
# FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE_ID=

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_SEMANTIC_VIEW=

# Google AI / Gemini API Key (used by LLM config)
GOOGLE_API_KEY=

# Sync Configuration
SYNC_MODE=bidirectional
DRY_RUN=false
LOG_LEVEL=INFO

# ORM Database Configuration
# Examples:
#   SQLite (default, zero-config):  sqlite:///~/.semabridge/semabridge.db
#   DuckDB via ORM dialect:         duckdb:///C:/Users/<you>/.semabridge/semabridge.db
#   PostgreSQL:                     postgresql+psycopg2://user:password@host:5432/semabridge
#   MySQL:                          mysql+pymysql://user:password@host:3306/semabridge
SEMABRIDGE_DATABASE_URL=duckdb:///C:/Users/<you>/.semabridge/semabridge_state.db

# Connection Pool (server databases: PostgreSQL, MySQL — ignored for SQLite/DuckDB)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true

# SSL (PostgreSQL / MySQL only)
# DB_SSL_MODE=require
# DB_SSL_CA=/path/to/ca-certificate.pem

# Schema name (multi-tenant PostgreSQL — creates/uses the given schema)
# DB_SCHEMA=semabridge

# Log all SQL statements emitted by SQLAlchemy (development only)
# DB_ECHO=false

# Orchestration & Distributed Processing
SEMABRIDGE_ORCHESTRATOR=local
TEMPORAL_HOST=localhost:7233
RAY_ADDRESS=ray://localhost:6379
TASK_QUEUE=semabridge-sync# Microsoft Fabric Configuration
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE_ID=


# Snowflake Configuration
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_SEMANTIC_VIEW=

# Sync Configuration
SYNC_MODE=bidirectional
DRY_RUN=false
LOG_LEVEL=INFO
