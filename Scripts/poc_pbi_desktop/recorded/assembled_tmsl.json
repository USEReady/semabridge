          {
            "name": "RunningMonths",
            "dataType": "int64",
            "type": "calculated",
            "expression": "((YEAR(DATE(2014, 6, 30))-[Year])*12 + MONTH(DATE(2014, 12, 31)) - [MonthNo] +1)",
            "summarizeBy": "sum",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "Running Year",
            "dataType": "string",
            "type": "calculated",
            "expression": "IF(CEILING([RunningMonths]/12, 1)>0, CEILING([RunningMonths]/12, 1), BLANK())",
            "summarizeBy": "sum"
          },
          {
            "name": "Running Months",
            "dataType": "string",
            "type": "calculated",
            "expression": "IF([Running Year]=1, \"Running 12 Months\", IF([Running Year]=2, \"Running 13-24 Months\", IF([Running Year]=3, \"Running 25-36 Months\", Blank())))",
            "summarizeBy": "none"
          },
          {
            "name": "Rolling Period",
            "dataType": "string",
            "type": "calculated",
            "expression": "IF([RunningMonths]<37&&[RunningMonths]>0,  \"P-\"&(RIGHT(\"0\"&([RunningMonths]-([Running Year]-1)*12-1), 2)))",
            "summarizeBy": "none",
            "sortByColumn": "Rolling Period Sort"
          },
          {
            "name": "Rolling Period Sort",
            "dataType": "int64",
            "type": "calculated",
            "expression": "IF([RunningMonths]>0 && [RunningMonths]<37,13- [RunningMonths] +12*(CEILING([RunningMonths]/12, 1)-1))",
            "summarizeBy": "sum"
          },
          {
            "name": "MonthIndex",
            "dataType": "string",
            "type": "calculated",
            "expression": "CALCULATE(DISTINCTCOUNT([Month]), FILTER(ALL('Date'), [Date]<=EARLIER([Date])))",
            "summarizeBy": "sum"
          },
          {
            "name": "Months",
            "dataType": "string",
            "type": "calculated",
            "expression": "LEFT('Date'[MonthName],3)",
            "summarizeBy": "none",
            "sortByColumn": "MonthNo"
