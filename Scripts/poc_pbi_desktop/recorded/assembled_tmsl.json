            "formatString": "#,0"
          },
          {
            "name": "Total VanArsdel Units YTD",
            "expression": "CALCULATE([Total Units YTD], FILTER(ALL(Product[isVanArsdel]), Product[isVanArsdel]=\"Yes\"))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "Total OTHER Units YTD",
            "expression": "CALCULATE([Total Units YTD], FILTER(ALL(Product[isVanArsdel]), Product[isVanArsdel]=\"No\"))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "Total VanArsdel Units",
            "expression": "CALCULATE([Total Units], FILTER(ALL(Product[isVanArsdel]), Product[isVanArsdel]=\"Yes\"))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "Total OTHER Units",
            "expression": "CALCULATE([Total Units], FILTER(ALL(Product[isVanArsdel]), Product[isVanArsdel]=\"No\"))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "% Units Market Share",
            "expression": "IF([Total VanArsdel Units]=0, 0, DIVIDE([Total VanArsdel Units], [Total Units], 0))",
            "dataType": "double",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Total Category Volume",
            "expression": "CALCULATE([Total Units])",
            "dataType": "int64",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "Total Compete Volume",
            "expression": "CALCULATE([Total Units], FILTER('Product', Product[isVanArsdel]=\"No\"))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "% Category Compete Share",
            "expression": "INT(DIVIDE([Total Compete Volume], [Total Category Volume])*100)",
            "dataType": "int64",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "TOTAL UNITS SPLY",
            "expression": "CALCULATE([TOTAL UNITS],SAMEPERIODLASTYEAR('Date'[Date]))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "Total Units YTD SPLY",
            "expression": "CALCULATE([Total Units YTD], SAMEPERIODLASTYEAR('Date'[Date]))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "Total VanArsdel Units YTD SPLY",
            "expression": "CALCULATE([Total VanArsdel Units YTD], SAMEPERIODLASTYEAR('Date'[Date]))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
