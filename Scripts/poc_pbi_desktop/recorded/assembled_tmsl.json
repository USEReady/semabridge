            "expression": "CALCULATE([Total OTHER Units YTD], SAMEPERIODLASTYEAR('Date'[Date]))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "% Units Market Share YTD",
            "expression": "DIVIDE([Total VanArsdel Units YTD], [Total Units YTD])",
            "dataType": "double",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Market Share SPLY YTD",
            "expression": "CALCULATE([% Units Market Share YTD], SAMEPERIODLASTYEAR('Date'[Date]))",
            "dataType": "double",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Unit Market Share YOY Change",
            "expression": "[% Units Market Share]-[% Units Market Share SPLY]",
            "dataType": "double",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Units Market Share SPLY",
            "expression": "CALCULATE([% Units Market Share], SAMEPERIODLASTYEAR('Date'[Date]))",
            "dataType": "double",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Total Units R12Ms",
            "expression": "CALCULATE(SUM([Units]), FILTER(ALL('Date'), 'Date'[MonthIndex]<=MAX('Date'[MonthIndex])&& 'Date'[MonthIndex]> MAX('Date'[MonthIndex])-12))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "Total VanArsdel Units R12M",
            "expression": "CALCULATE([Total Units R12Ms], FILTER(ALL(Product[isVanArsdel]), Product[isVanArsdel]=\"Yes\"))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "Total OTHER Units R12M",
            "expression": "CALCULATE([Total Units R12Ms], FILTER(ALL(Product[isVanArsdel]), Product[isVanArsdel]=\"No\"))",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "% Units Market Share R12M",
            "expression": "IF([Total VanArsdel Units R12M]=0, 0, DIVIDE([Total VanArsdel Units R12M], [Total Units R12Ms], 0))",
            "dataType": "double",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Sentiment Gap",
            "expression": "IF(ISBLANK(CALCULATE([Sentiment], Manufacturer[MfgisVanArsdel]=\"No\"))||ISBLANK(CALCULATE([Sentiment], Manufacturer[MfgisVanArsdel]=\"Yes\")), BLANK(), CALCULATE([Sentiment], Manufacturer[MfgisVanArsdel]=\"No\") - CALCULATE([Sentiment], Manufacturer[MfgisVanArsdel]=\"Yes\"))",
            "dataType": "double",
            "formatString": "0"
          },
          {
            "name": "Total Units YTD Var",
            "expression": "[Total Units YTD]-[Total Units YTD SPLY]",
            "dataType": "int64",
            "formatString": "#,0"
          },
          {
            "name": "Total Units YTD Var %",
            "expression": "DIVIDE([Total Units YTD Var],[TOTAL UNITS SPLY])",
            "dataType": "double",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Sum of Units",
            "expression": "SUM('SalesFact'[Units])",
            "dataType": "int64"
          },
          {
            "name": "Sum of Revenue",
            "expression": "SUM('SalesFact'[Revenue])",
            "dataType": "decimal"
          },
          {
            "name": "@Indicator01",
            "expression": "IF('SalesFact'[% Category Compete Share]<0.55,1,IF('SalesFact'[% Category Compete Share]>0.6,3,2))",
            "dataType": "int64",
            "formatString": "0"
          },
          {
            "name": "@Indicator02",
            "expression": "IF('SalesFact'[% Unit Market Share YOY Change]<0,1,IF('SalesFact'[% Unit Market Share YOY Change]>.2,3,2))",
            "dataType": "int64",
            "formatString": "0"
          },
          {
            "name": "#Space01",
            "expression": "\"\" ",
            "dataType": "string"
          },
          {
            "name": "#Space02",
            "expression": "\"\" ",
            "dataType": "string"
          },
          {
            "name": "@Indicator03",
            "expression": "IF('SalesFact'[Total Units YTD Var %]<0,1,IF('SalesFact'[Total Units YTD Var %]>0.1,3,2))",
            "dataType": "int64",
            "formatString": "0"
          },
          {
            "name": "@Indicator04",
            "expression": "IF('SalesFact'[Sentiment]<65,1,IF('SalesFact'[Sentiment]>67,3,2))",
            "dataType": "int64",
            "formatString": "0"
          },
          {
            "name": "@Indicator05",
            "expression": "IF('SalesFact'[Sentiment Gap]<15,1,IF('SalesFact'[Sentiment Gap]>25,3,2))",
            "dataType": "int64",
            "formatString": "0"
          },
          {
            "name": "@Indicator04A",
            "expression": "IF('SalesFact'[@Indicator04]=1,\"Low Sentiment Rate\",IF('SalesFact'[@Indicator04]=3,\"High Sentiment Rate\",\"Medium Sentiment Rate\"))",
            "dataType": "string"
          },
          {
            "name": "@Indicator05A",
            "expression": "IF('SalesFact'[@Indicator05]=1,\"Low Sentiment Gap\",IF('SalesFact'[@Indicator05]=3,\"High Sentiment Gap\",\"Medium Sentiment Gap\"))",
            "dataType": "string"
          },
          {
            "name": "Total Units YTD Var %2",
            "expression": "INT(DIVIDE([Total Units YTD Var],[TOTAL UNITS SPLY])*100)",
            "dataType": "int64"
          }
        ]
      },
